{% extends "main_card.html.twig" %}

{% block title %}
    {% trans %}part.info.title{% endtrans %} {{ part.name }}
{% endblock %}

{% block card_type %}

    {% if timeTravel == null %}
        bg-primary text-white
    {% else %}
        bg-primary-striped text-white
    {% endif %}

{% endblock %}

{% block card_title %}
    <span>
        <i class="fa {{ part.favorite ? 'fa-star' : 'fa-info-circle'}} fa-fw" aria-hidden="true"></i>
        {% trans %}part.info.title{% endtrans %} <b>"{{ part.name }}"</b>
        {% if timeTravel != null %}
            <i>({{ timeTravel | format_datetime('short') }})</i>
        {% endif %}
        {% if part.projectBuildPart %}
            (<i>{{ type_label(part.builtProject) }}</i>: <a class="text-white" href="{{ entity_url(part.builtProject) }}">{{ part.builtProject.name }}</a>)
        {% endif %}
    </span>
    <span class="float-end">
        {% trans %}id.label{% endtrans %}: {{ part.id }} {% if part.ipn is not empty %}(<i>{{ part.ipn }}</i>){% endif %}
    </span>
{% endblock %}

{% block card_content %}
    <div class="row">
        <div class="col col-md-3 mt-auto mb-auto">
            {% include "parts/info/_picture.html.twig" %}
            {% include "tools/component_image_generator/_generate_modal.html.twig" %}
        </div>

        <div class="col-12 col-md-9 col-lg-6">
            {% include "parts/info/_main_infos.html.twig" %}
        </div>

        <div class="col offset-md-3 offset-lg-0">
            {% include "parts/info/_sidebar.html.twig" %}
        </div>
    </div>

    {# All tabs of this page, in the order they are shown in the tab bar. The keys are the IDs of the tab panes. #}
    {% set has_parameters = part.parameters is not empty or description_params is not empty or comment_params is not empty %}
    {% set tabs = {
        part_lots: {tab_id: 'part_lots-tab', icon: 'fas fa-box fa-fw', label: 'part.part_lots.label', count: part.partLots | length},
        comment: {tab_id: 'comment-tab', icon: 'fas fa-sticky-note fa-fw', label: 'comment.label', shown: part.comment is not empty},
        specifications: {tab_id: 'specifications-tab', icon: 'fas fa-atlas fa-fw', label: 'part.info.specifications', count: part.parameters | length, shown: has_parameters},
        attachments: {tab_id: 'attachment-tab', icon: 'fas fa-paperclip fa-fw', label: 'attachment.labelp', count: part.attachments | length, shown: part.attachments is not empty},
        suppliers: {tab_id: 'supplier-tab', icon: 'fas fa-shopping-cart fa-fw', label: 'vendor.partinfo.shopping_infos', count: part.orderdetails | length, shown: part.orderdetails is not empty},
        associations: {tab_id: 'associations-tab', icon: 'fas fa-circle-nodes fa-fw', label: 'part.edit.tab.associations', count: part.associatedPartsAll | length, shown: part.associatedPartsAll is not empty},
        history: {tab_id: 'history-tab', icon: 'fas fa-history', label: 'vendor.partinfo.history', disabled: datatable is null},
        projects: {tab_id: 'projects-tab', icon: 'fas fa-archive fa-fw', label: 'project.labelp', count: part.projectBomEntries | length, shown: part.projectBomEntries is not empty},
        tools: {tab_id: 'tools-tab', icon: 'fas fa-tools', label: 'tools.label'},
        extended_info: {tab_id: 'extended_info-tab', icon: 'fas fa-clipboard-list', label: 'extended_info.label'},
    } %}

    {# The tabs which are shown together as one combined tab (mapping the pane ID to its position). Only tabs which
       exist for this part can be combined, and it needs at least two of them. #}
    {% set combined = {} %}
    {% for tab in settings_instance('part_info').combinedTabs %}
        {% set tab_info = tabs[tab.value] ?? null %}
        {% if tab_info is not null and (tab_info.shown ?? true) and not (tab_info.disabled ?? false) %}
            {% set combined = combined | merge({(tab.value): combined | length}) %}
        {% endif %}
    {% endfor %}
    {% if combined | length < 2 %}
        {% set combined = {} %}
    {% endif %}

    <div class="" {{ stimulus_controller('pages/part_info_tabs') }}>
        <ul class="nav nav-tabs" id="partTab" role="tablist">
            {% if combined is not empty %}
                {# The href contains the IDs of all combined panes, bootstrap just toggles the first one,
                   the others are handled by the part_info_tabs controller #}
                <li class="nav-item">
                    <a class="nav-link active" id="combined-tab" data-bs-toggle="tab"
                       href="#{{ combined | keys | join(',') }}" data-bs-target="#{{ combined | keys | first }}" role="tab">
                        {% for id in combined | keys %}
                            {{ _self.tab_label(tabs[id]) }}
                            {% if not loop.last %}<span class="text-muted mx-1">+</span>{% endif %}
                        {% endfor %}
                    </a>
                </li>
            {% endif %}
            {% for id, tab in tabs %}
                {% if (tab.shown ?? true) and combined[id] is not defined %}
                    {% set disabled = tab.disabled ?? false %}
                    <li class="nav-item {% if disabled %}not-allowed{% endif %}">
                        <a class="nav-link {% if disabled %}disabled{% endif %} {% if combined is empty and id == 'part_lots' %}active{% endif %}"
                           id="{{ tab.tab_id }}" data-bs-toggle="tab" href="#{{ id }}" role="tab">
                            {{ _self.tab_label(tab) }}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
        <div class="tab-content {% if combined is not empty %}d-flex flex-column{% endif %}" id="myTabContent" {{ stimulus_target('pages/part_info_tabs', 'content') }}>
            {% if part.comment is not empty %}
                <div {{ _self.pane_attributes('comment', tabs, combined) }}>
                    {{ _self.pane_heading('comment', tabs, combined) }}
                    <div class="container-fluid mt-2 latex" data-controller="common--latex">
                        {{ part.comment|format_markdown }}
                    </div>
                </div>
            {% endif %}

            <div {{ _self.pane_attributes('part_lots', tabs, combined) }}>
                {{ _self.pane_heading('part_lots', tabs, combined) }}
                {% include "parts/info/_part_lots.html.twig" %}
            </div>

            {% if part.attachments is not empty %}
                <div {{ _self.pane_attributes('attachments', tabs, combined) }}>
                    {{ _self.pane_heading('attachments', tabs, combined) }}
                    {% include "parts/info/_attachments_info.html.twig" %}
                </div>
            {% endif %}

            {% if part.orderdetails is not empty %}
            <div {{ _self.pane_attributes('suppliers', tabs, combined) }}>
                {{ _self.pane_heading('suppliers', tabs, combined) }}
                {%  include "parts/info/_order_infos.html.twig" %}
            </div>
            {% endif %}

            {% if part.associatedPartsAll is not empty %}
                <div {{ _self.pane_attributes('associations', tabs, combined) }}>
                    {{ _self.pane_heading('associations', tabs, combined) }}
                    {%  include "parts/info/_associations.html.twig" %}
                </div>
            {% endif %}

            <div {{ _self.pane_attributes('projects', tabs, combined) }}>
                {{ _self.pane_heading('projects', tabs, combined) }}
                {% include "parts/info/_projects.html.twig" %}
            </div>

            <div {{ _self.pane_attributes('history', tabs, combined) }}>
                {{ _self.pane_heading('history', tabs, combined) }}
                {% include "parts/info/_history.html.twig" %}
            </div>

            <div {{ _self.pane_attributes('tools', tabs, combined) }}>
                {{ _self.pane_heading('tools', tabs, combined) }}
                {% include "parts/info/_tools.html.twig" %}
            </div>

            {% if has_parameters %}
                <div {{ _self.pane_attributes('specifications', tabs, combined) }}>
                    {{ _self.pane_heading('specifications', tabs, combined) }}
                    {% include "parts/info/_specifications.html.twig" %}
                </div>
            {% endif %}

            <div {{ _self.pane_attributes('extended_info', tabs, combined) }}>
                {{ _self.pane_heading('extended_info', tabs, combined) }}
                {% include "parts/info/_extended_infos.html.twig" %}

            </div>
        </div>
    </div>
{% endblock %}

{# The icon, name and counter badge of a tab, like shown in the tab bar #}
{% macro tab_label(tab) %}
    <i class="{{ tab.icon }}"></i>
    {{ tab.label | trans }}
    {% if tab.count is defined %}
        <span class="badge bg-secondary">{{ tab.count }}</span>
    {% endif %}
{% endmacro %}

{# The attributes of a tab pane. Several panes can be active at once, if they are shown combined. #}
{% macro pane_attributes(id, tabs, combined) -%}
    {%- set active = combined[id] is defined or (combined is empty and id == 'part_lots') -%}
    class="tab-pane fade{% if active %} show active{% endif %}" id="{{ id }}" role="tabpanel" aria-labelledby="{{ combined[id] is defined ? 'combined-tab' : tabs[id].tab_id }}"
    {%- if combined[id] is defined %} style="order: {{ combined[id] }};"{% endif -%}
{%- endmacro %}

{# The heading of a tab pane, which is only visible if several panes are shown together #}
{% macro pane_heading(id, tabs, combined) %}
    <h5 class="border-bottom pb-1 mt-3 {% if combined[id] is not defined %}d-none{% endif %}" {{ stimulus_target('pages/part_info_tabs', 'heading') }}>
        {{ _self.tab_label(tabs[id]) }}
    </h5>
{% endmacro %}
