{% if not pictures is empty %}
    {#  <img src="{{ part.masterPictureAttachment | entityURL('file_view') }}" class="img-fluid img-thumbnail bg-light" alt="Part main image" height="300" width="300"> #}

    {# With more than one picture, hovering the picture fans all of them out next to it (see part_picture_fan_controller.js) #}
    {% set fan_enabled = pictures | length > 1 %}
    {# A click in the fan is only saved as the new preview picture, if the user is allowed to edit the (current version of the) part #}
    {% set fan_persist = fan_enabled and part.id is not null and timeTravel is null and is_granted('edit', part) %}
    <div class="part-picture-fan mb-2" {% if fan_enabled %}{{ stimulus_controller('pages/part_picture_fan', fan_persist ? {
        url: path('part_set_master_picture', {id: part.id}),
        csrf: csrf_token('set_master_picture' ~ part.id),
        master: part.masterPictureAttachment ? part.masterPictureAttachment.id : 0,
    } : {}) }}{% endif %}>
    <div id="pictureCarousel" class="carousel slide" data-bs-interval="false" data-bs-ride="false" {% if fan_enabled %}{{ stimulus_target('pages/part_picture_fan', 'carousel') }}{% endif %}>
        <div class="carousel-indicators">
            {% for pic in pictures %}
                <button type="button" data-bs-target="#pictureCarousel" data-bs-slide-to="{{ loop.index0 }}" {% if loop.first %}class="active" aria-current="true"{% endif %} aria-label="{{ pic.name }}"></button>
            {% endfor %}
        </div>
        <div class="carousel-inner">
            {% for pic in pictures %}
                {# @var pic App\Entity\Attachments\Attachment #}
                <div class="carousel-item  {% if loop.first %}active{% endif %}">
                    <a href="{{ entity_url(pic, 'file_view') }}" data-turbo="false" target="_blank" rel="noopener">
                        <img class="d-block w-100 img-fluid img-thumbnail bg-light part-info-image" src="{{ entity_url(pic, 'file_view') }}" alt="">
                        {% if settings_instance("part_info").showPartImageOverlay %}
                        <div class="mask"></div>
                        <div class="carousel-caption-hover">
                            <div class="carousel-caption text-white">
                                <div><b>{{ pic.name }}</b></div>
                                <div>{% if pic.filename %}({{ pic.filename }}) {% endif %}</div>
                                <div>{{ type_label(pic.element) }}</div>
                            </div>
                        </div>
                        {% endif %}
                    </a>
                </div>
            {% endfor %}
        </div>
        {% if pictures | length > 1 %}
            <button type="button" class="carousel-control-prev" data-bs-target="#pictureCarousel" role="button" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">{% trans %}part.info.prev_picture{% endtrans %}</span>
            </button>
            <button type="button" class="carousel-control-next" data-bs-target="#pictureCarousel" role="button" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">{% trans %}part.info.next_picture{% endtrans %}</span>
            </button>
        {% endif %}
    </div>
    {% if fan_enabled %}
        <div class="part-picture-fan-strip" role="group" aria-label="{% trans %}part.info.picture_fan.label{% endtrans %}">
            <div class="part-picture-fan-items">
                {% for pic in pictures %}
                    {# Only pictures of the part itself can become its preview picture, not the ones inherited from its footprint, category, etc. #}
                    {% set pic_persist = fan_persist and pic.element is same as(part) %}
                    <button type="button" class="part-picture-fan-item {% if loop.first %}active{% endif %} {% if part.masterPictureAttachment is same as(pic) %}is-master{% endif %}"
                            style="--fan-index: {{ loop.index0 }};"
                            aria-label="{{ pic.name }}"
                            {{ stimulus_target('pages/part_picture_fan', 'item') }}
                            {{ stimulus_action('pages/part_picture_fan', 'select', 'click') }}
                            data-index="{{ loop.index0 }}" {% if pic_persist %}data-attachment-id="{{ pic.id }}"{% endif %}>
                        <img class="img-thumbnail bg-light" src="{{ attachment_thumbnail(pic, 'thumbnail_sm') ?? entity_url(pic, 'file_view') }}" alt="" loading="lazy">
                    </button>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    </div>

{% else %}
    <div class="position-relative d-inline-block mb-2 part-image-placeholder">
        <img src="{{ asset('img/part_placeholder.svg') }}" class="img-fluid img-thumbnail bg-light" alt="Part main image" height="300" width="300">
        {# No picture yet: offer to generate one right here #}
        {% if part.id is not null and is_granted('edit', part) and is_granted('@tools.component_image_generator') %}
            <div class="position-absolute bottom-0 end-0 m-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#vcGenerateModal" title="{% trans %}tools.value_calc.attach.generate_button{% endtrans %}">
                    <i class="fas fa-palette"></i>
                </button>
            </div>
        {% endif %}
    </div>
{% endif %}
