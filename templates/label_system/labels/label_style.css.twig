@page {
    margin: 12px 6px;
}

.page {
    /** We cannot apply the position: absolute trick here, because then dompdf will not respect the page break anymore **/

    page-break-inside: avoid;
    page-break-before: avoid;
    page-break-after: always;

    overflow: hidden;
    width: 100%;
    height: 100%;
}

.page-inner {
    /* Absolute position prevents automatic page breaks */
    /*position: absolute;*/
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    overflow: hidden;

    page-break-inside: avoid;
    page-break-before: avoid;
    page-break-after: avoid;
}

/* Last page should not break */
.page:last-of-type {
    page-break-after: avoid;
}

body {
    font-family: "DejaVu Sans Mono", "unifont", monospace;
    font-size: 12px;
    line-height: 1.0;
}

p {
    margin: 0;
}

hr {
    margin: 2px;
}

.qr {
    max-width: 80%;
    max-height: 100%;
}

.qr-container a {
    display: block;
}

.C39 {
    max-width: 150px;
}

.C39-container {
    display: inline-block;
    align-content: center;
    text-align: left;
    position: fixed;
    bottom: 32px;
}

/* Layout used for labels with a barcode size set (see label_page_barcode.html.twig). Barcode sizes are set inline.
   All rules are scoped to .label-layout, so that the legacy layouts (label_page_qr/1d.html.twig) are not affected. */
.label-layout {
    width: 100%;
    border-collapse: collapse;
}

.label-layout td {
    padding: 0;
    vertical-align: top;
}

.label-layout .barcode-cell-left {
    padding-right: 4mm;
}

.label-layout .barcode-cell-bottom {
    padding-top: 1mm;
}

/* Block elements, so that there is no additional line spacing around the barcodes */
.label-layout .qr, .label-layout .C39 {
    display: block;
    max-width: none;
    max-height: none;
}

.label-layout .C39-container {
    display: block;
    position: static;
}

/* Barcodes and part images placed inside the lines (see LabelHTMLGenerator::replacePlaceholderImages()).
   dompdf clips inline images taller than the line at the top of the page, unless they are aligned to the top. */
img.partdb-barcode, img.partdb-part-image {
    vertical-align: top;
}

/* The part image is centered in the placeholder via padding, which must not be added to the size */
img.partdb-part-image {
    box-sizing: content-box;
}

.C39-text {
    display: block;
    font-size: 6pt;
}

/* Images resized in CKEditor only get a width style, while keeping the width/height attributes of the original image
   (and an aspect-ratio style, which dompdf does not support). So we must reset the height, to keep the aspect ratio. */
img.image_resized {
    height: auto;
}

.image.image_resized {
    display: block;
    max-width: 100%;
}

.image.image_resized img {
    width: 100%;
    height: auto;
}

/* Only for images with a style applied, so that the default images of existing labels do not change */
.image-style-align-left img, .image-style-align-right img, .image-style-side img,
.image-style-align-center img, .image-style-block-align-left img, .image-style-block-align-right img {
    max-width: 100%;
    height: auto;
}

/* Image styles of CKEditor, which are applied via the image toolbar (should be the same as in ckeditor.css).
   Images without a style keep the default positioning of dompdf, so that existing labels do not change. */
/* Wrapped images (and placed barcodes) keep a 4mm gap to the text, the same as in the layout with a barcode size
   (label_page_barcode.html.twig), which also leaves enough space around barcodes to scan them reliably (see also ckeditor.css) */
.image-style-align-left {
    float: left;
    margin: 0 4mm 0 0;
}

/* The "side" style of older versions of the label editor was replaced by "align-right" (see PartDBLabelImageStyles.js) */
.image-style-align-right,
.image-style-side {
    float: right;
    margin: 0 0 0 4mm;
}

/* Block images with a style have no vertical margins (like in the label editor), images without a style keep the default ones */
.image-style-align-center, .image-style-block-align-left, .image-style-block-align-right {
    margin-top: 0;
    margin-bottom: 0;
}

.image-style-align-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.image-style-block-align-left {
    margin-left: 0;
    margin-right: auto;
    text-align: left;
}

.image-style-block-align-right {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
}

