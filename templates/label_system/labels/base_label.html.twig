{% import "vars.macro.twig" as vars %}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ meta_title }}</title>
    <meta name="author" content="{{ vars.partdb_title() }}">
    <meta name="description" content="Label for {{ meta_title }}">
    <meta name="keywords" content="Part-DB, Label, Barcode">
    <style>
        {% include("label_system/labels/label_style.css.twig") %}
        {# We must not escape it here, as the string might contain ", which would be escaped. As user can control the whole HTML, XSS is not really a problem here. #}
        {{ options.additionalCss | raw }}
    </style>
</head>
<body>
    {% set start_page %}
    {# The page div ensures the page breaks, while the page-inner elements restrict the content to the page size. Since dompdf 3.1.1 we cannot apply the position: absolute; to the page element directly. #}
    <div class="page">
    <div class="page-inner">
    <table col="{{ options.gridColumns }}" row="{{ options.gridRows }}">
    <tr>
    {% endset %}

    {% set end_page %}
    </tr>
    </table>
    </div>
    </div>
    {% endset %}

    {% set reduced_skip_count = options.skipCount % (options.gridColumns * options.gridRows) %}
    {% set header = [] %}
    {% if reduced_skip_count > 0 %}
        {% for i in (1 .. reduced_skip_count) %}
            {% set header = header|merge({(-reduced_skip_count + i): null}) %}
        {% endfor %}
    {% endif %}

    {% set incomplete_row = (elements|length + header|length) % options.gridColumns %}
    {% set trailer = [] %}
    {% if options.gridColumns > 1 and incomplete_row > 0 %}
        {% for i in (incomplete_row + 1 .. options.gridColumns) %}
            {% set trailer = trailer|merge({(elements|length + header|length + i): null}) %}
        {% endfor %}
    {% endif %}
    {% set labels = header|merge(elements)|merge(trailer) %}

    {{ start_page }}
        {% for element in labels %}
            <td>
            {% if element is null %}
                {# generate an empty placeholder #}
            {% elseif options.barcodeType.none %}
                {% include "label_system/labels/label_page_none.html.twig" %}
            {% elseif options.barcodeType.is2D() %}
                {% include "label_system/labels/label_page_qr.html.twig" %}
            {% elseif options.barcodeType.is1D() %}
                {% include "label_system/labels/label_page_1d.html.twig" %}
            {% endif %}
            </td>
            {% if not loop.last %}
                {# The current page is full and there are still labels in the queue. Start a new page #}
                {% if loop.index is divisible by(options.gridColumns * options.gridRows) %}
                    {{ end_page }}
                    {{ start_page }}
                {# The current row is full. Start a new row #}
                {% elseif (options.gridRows > 1) and loop.index is divisible by(options.gridColumns) %}
                    </tr><tr>
                {% endif %}
            {% endif %}
        {% endfor %}
    {{ end_page }}
</body>
</html>

