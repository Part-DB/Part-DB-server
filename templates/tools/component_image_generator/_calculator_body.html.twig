                                            <option value="0402">0402 (1005 metric)</option>
                                            <option value="0603">0603 (1608 metric)</option>
                                            <option value="0805">0805 (2012 metric)</option>
                                            <option value="1206">1206 (3216 metric)</option>
                                            <option value="1210" selected>1210 (3225 metric)</option>
                                            <option value="2010">2010 (5025 metric)</option>
                                            <option value="2512">2512 (6332 metric)</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row">
                                    <label for="vc-smdind-body" class="col-sm-3 col-form-label">{% trans %}tools.value_calc.body_color{% endtrans %}</label>
                                    <div class="col-sm-9 d-flex align-items-center flex-wrap gap-2">
                                        <input type="color" class="form-control form-control-color" id="vc-smdind-body" value="#38332e"
                                               title="{% trans %}tools.value_calc.body_color{% endtrans %}"
                                               {{ stimulus_target('pages/component_image_generator', 'smdIndBodyColor') }}
                                               {{ stimulus_action('pages/component_image_generator', 'syncSmdInductor', 'input') }}>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-secondary" data-color="#38332e"
                                                    {{ stimulus_action('pages/component_image_generator', 'applySmdIndBodyColor') }}>{% trans %}tools.value_calc.body.black{% endtrans %}</button>
                                            <button type="button" class="btn btn-outline-secondary" data-color="#4a4a4a"
                                                    {{ stimulus_action('pages/component_image_generator', 'applySmdIndBodyColor') }}>{% trans %}tools.value_calc.body.grey{% endtrans %}</button>
                                            <button type="button" class="btn btn-outline-secondary" data-color="#1c3a5e"
                                                    {{ stimulus_action('pages/component_image_generator', 'applySmdIndBodyColor') }}>{% trans %}tools.value_calc.body.blue{% endtrans %}</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </details>
                    </div>
                    <div class="col-lg-5">
                        <div class="position-sticky" style="top: 1rem;">
                            <div class="vc-pic text-center bg-light rounded p-2 mx-auto" style="max-width: 480px;" {{ stimulus_target('pages/component_image_generator', 'smdIndSvg') }}></div>
                            <div class="text-center text-muted small mt-2" {{ stimulus_target('pages/component_image_generator', 'smdIndSpec') }}></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3 pt-3 border-top d-flex justify-content-center flex-wrap gap-2">
            <button type="button" class="btn btn-outline-secondary" {{ stimulus_action('pages/component_image_generator', 'downloadSvg') }}>
                <i class="fas fa-download"></i> {% trans %}tools.value_calc.download.button{% endtrans %}
            </button>
            {% if part is not null %}
                <button type="button" class="btn btn-success" {{ stimulus_action('pages/component_image_generator', 'attachToPart') }}>
                    <i class="fas fa-paperclip"></i> {% trans %}tools.value_calc.attach.button{% endtrans %}
                </button>
            {% endif %}
        </div>
    </div>
