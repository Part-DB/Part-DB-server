                                            <button type="button" class="btn btn-outline-secondary" data-color="#9fc6e0"
                                                    {{ stimulus_action('pages/component_image_generator', 'applyResistorBodyColor') }}>{% trans %}tools.value_calc.body.lightblue{% endtrans %}</button>
                                            <button type="button" class="btn btn-outline-secondary" data-color="#3f6fb0"
                                                    {{ stimulus_action('pages/component_image_generator', 'applyResistorBodyColor') }}>{% trans %}tools.value_calc.body.blue{% endtrans %}</button>
                                            <button type="button" class="btn btn-outline-secondary" data-color="#3f7d4f"
